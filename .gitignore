# Project-specific ignores
# Datasets and checkpoints (stored on shared Drive, never in git)
data/dataset_*/
data/uploads/
data/overlays/
data/tiles/

# Sample images and model files
samples/*.png
*.pt
*.onnx
*.h5
*.pkl

# Run logs (keep CSV but ignore other files)
runs/*
!runs/RUN_LOG.csv

# Python artifacts
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Node and build artifacts
node_modules/
.next/
out/

# Environment files
.env*.local

# IDE/editor files
.idea/
.vscode/

# OS files
.DS_Store

# v0 sandbox internal files
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/